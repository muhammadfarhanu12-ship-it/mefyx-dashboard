# Mefyx AI Gateway backend configuration
# Optional template only. The running backend reads backend-ai/.env locally
# and Render environment variables in production.

# Required core runtime
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster.example.mongodb.net/<db_name>?retryWrites=true&w=majority
MONGO_DB_NAME=sentinel_dashboard
JWT_SECRET=<replace_with_long_random_jwt_secret>
ADMIN_JWT_SECRET=<replace_with_long_random_admin_jwt_secret>
API_KEY_SECRET=<replace_with_long_random_api_key_secret>

# Public URLs and CORS
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-admin.vercel.app
# ALLOWED_ORIGINS is also supported as an alias for CORS_ORIGINS.
FRONTEND_URL=https://your-frontend.vercel.app
ADMIN_FRONTEND_URL=https://your-admin.vercel.app
# ADMIN_PANEL_URL is also supported as an alias for ADMIN_FRONTEND_URL.
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Auth/session behavior
APP_ENV=development
JWT_ALGORITHM=HS256
JWT_ISSUER=sentinelcore
JWT_AUDIENCE=sentinelcore-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
AUTH_DEBUG_TOKEN_LOGGING=false
AUTH_TEST_FLOW_ENABLED=false
BLOCKED_EMAIL_DOMAINS=

# Turnstile: configure your actual secret ONLY here / in the Render backend environment.
# Configure the matching public VITE_TURNSTILE_SITE_KEY in frontend for the Contact Form.
TURNSTILE_SECRET_KEY=
# Exact browser hostnames, no schemes, ports or wildcards. Required in production.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_TIMEOUT_SECONDS=10
# Defaults to mongo in production and memory in development; production requires mongo.
# PUBLIC_RATE_LIMIT_BACKEND=mongo
PUBLIC_RATE_LIMIT_TIMEOUT_SECONDS=3
# Set FORWARDED_ALLOW_IPS on Render to the actual trusted reverse proxy addresses.
# Never trust '*' when clients can connect directly to the backend listener.

# Optional bootstrap admin. Set both values or leave both blank.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_LOGIN_ALERT_EMAIL=

# AI providers
AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=openai
AI_PROVIDER_TIMEOUT_SECONDS=30
GEMINI_API_KEY=example_gemini_key_replace_me
OPENAI_API_KEY=example_openai_key_replace_me

# Security and request limits
LOG_LEVEL=INFO
MAX_REQUEST_SIZE_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_UPLOAD_TYPES=text/plain,application/json,text/csv,application/pdf,application/xml
ALLOWED_FILE_EXTENSIONS=.txt,.json,.csv,.pdf,.xml
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Sentinel enforcement
SENTINEL_RISK_THRESHOLD=70
SENTINEL_MAX_DECODE_DEPTH=3
SENTINEL_MAX_DECODE_PAYLOAD_CHARS=24000
SENTINEL_DECODE_TIMEOUT_MS=400
SENTINEL_REQUIRE_2FA_FOR_SENSITIVE_TOOLS=true
SENTINEL_ENABLE_2FA_ENFORCEMENT=true
SENTINEL_2FA_STATIC_CODE=
SENTINEL_2FA_ALLOW_DEMO_BYPASS=false

# Email delivery over Resend HTTPS. Verify the sending domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Mefyx <noreply@mefyx.com>"

# Remediation alerts
REMEDIATION_ENABLED=true
REMEDIATION_THREAT_SCORE_THRESHOLD=0.9
REMEDIATION_EMAIL_ENABLED=true
REMEDIATION_EMAIL_TO=
REMEDIATION_WEBHOOK_URLS=
REMEDIATION_WEBHOOK_TIMEOUT_SECONDS=3

# Creem billing (use matching test credentials/products until going live)
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID_PRO=
CREEM_PRODUCT_ID_BUSINESS=
CREEM_TEST_MODE=true

# --- Added by the security audit -------------------------------------------------------------
# What to do if a prompt scan times out / crashes: "closed" blocks unless fast rules clear it (recommended),
# "open" forwards the request (fast rules still block known attacks).
SCAN_FAIL_MODE=closed
# Scan developer "system" / model "assistant" messages as untrusted too (default false: only user messages).
GATEWAY_SCAN_NON_USER_ROLES=false
# Require a Cloudflare Turnstile token on signup/login/forgot/reset/resend. Enable only after the web app
# renders the widget on those pages (needs TURNSTILE_SECRET_KEY + TURNSTILE_ALLOWED_HOSTNAMES).
AUTH_REQUIRE_TURNSTILE=false
